# Скопіюй у .env (він у .gitignore) і заповни. Завантаження: set -a; source .env; set +a
# Абсолютний шлях до репо (у WSL: /home/<user>/src/agent-team)
AGENT_TEAM_DIR=/home/roman/src/agent-team

# Моделі: формат provider/model, див. `openclaw models list` і README «Моделі».
# *_FALLBACK_MODEL — запасна модель на rate limit (429) чи збій; з іншим лімітом TPM, ніж основна.
# OpenAI (ціна $/1M input / output / cache read з каталогу OpenClaw 2026.9.8):
#   gpt-6-luna 0.1/0.5/0.01 · gpt-5.6-luna 1/6/0.1 · gpt-6-sol 2/10/0.2 · gpt-6.1-sol 2/10/0.1 · gpt-6-astra 10/50/1
# lead: оркестрація, коментарі й review за чеклістом
LEAD_MODEL=openai/gpt-6-luna
LEAD_FALLBACK_MODEL=openai/gpt-5.6-luna
# ba: перевірка спеки
BA_MODEL=openai/gpt-6-luna
BA_FALLBACK_MODEL=openai/gpt-5.6-luna
# architect: план і ADR
ARCHITECT_MODEL=openai/gpt-6-sol
ARCHITECT_FALLBACK_MODEL=openai/gpt-6.1-sol
# dev: код; gpt-6-astra вп'ятеро дорожча на вхід і вдесятеро на кеш, вмикай лише якщо sol не справляється
DEV_MODEL=openai/gpt-6.1-sol
DEV_FALLBACK_MODEL=openai/gpt-6-sol
# qa: тести за спекою
QA_MODEL=openai/gpt-6-sol
QA_FALLBACK_MODEL=openai/gpt-6.1-sol
OPENAI_API_KEY=
# Або Anthropic: моделі anthropic/claude-sonnet-5-5 (lead, ba, qa) і anthropic/claude-opus-5-5 (architect, dev)
ANTHROPIC_API_KEY=

# Fine-grained PAT лише на Roman-Sharabura/dopamine-shop, окремий на кожного агента.
# lead: Issues RW, Pull requests RW (review, draft → ready), Contents R, Commit statuses R, Metadata R
GH_TOKEN_LEAD=
# ba: лише читає спеку — Contents R, Metadata R
GH_TOKEN_BA=
# architect: створює гілку з plan.md і tasks.md — Contents RW, Metadata R
GH_TOKEN_ARCHITECT=
# dev: Contents RW, Pull requests RW, Issues RW, Metadata R
GH_TOKEN_DEV=
# qa: Contents RW, Pull requests RW (коментар з вердиктом), Issues R, Metadata R
GH_TOKEN_QA=

# Пароль спільного Postgres для тестів у пісочниці (контейнер agent-team-postgres, назовні не відкритий)
AGENT_PG_PASSWORD=postgres

# Slack (Socket Mode), див. README «Slack»
# App-Level Token (xapp-...) зі scope connections:write
SLACK_APP_TOKEN=
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# Твій Slack member ID (U...): профіль → ⋮ → Copy member ID
SLACK_OWNER_ID=

# Ранковий брифінг (scripts/automations.sh): cron і часовий пояс, типово пн–пт 09:00 за Києвом
BRIEFING_CRON="0 9 * * 1-5"
BRIEFING_TZ=Europe/Kyiv

# Telegram (необов'язково, вимкнено в openclaw.json5): бот від @BotFather і твій числовий id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
