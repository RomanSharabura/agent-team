# Скопіюй у .env (він у .gitignore) і заповни. Завантаження: set -a; source .env; set +a
AGENT_TEAM_DIR=/Users/roman/src/agent-team

# Моделі: формат provider/model, див. `openclaw models list`
LEAD_MODEL=anthropic/claude-sonnet-5-5
DEV_MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=

# Fine-grained PAT лише на RomanSharabura/dopamine-shop, окремий на кожного агента.
# lead: Issues RW, Contents R, Metadata R
GH_TOKEN_LEAD=
# dev: Contents RW, Pull requests RW, Issues RW, Metadata R
GH_TOKEN_DEV=

# Telegram: бот від @BotFather і твій числовий id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
