# Скопіюй у .env (він у .gitignore) і заповни. Завантаження: set -a; source .env; set +a
# Абсолютний шлях до репо (у WSL: /home/<user>/src/agent-team)
AGENT_TEAM_DIR=/home/roman/src/agent-team

# Моделі: формат provider/model, див. `openclaw models list`
LEAD_MODEL=anthropic/claude-sonnet-5-5
# ba: перевірка спеки, достатньо швидкої моделі
BA_MODEL=anthropic/claude-sonnet-5-5
# architect: план і ADR, потрібна сильна модель
ARCHITECT_MODEL=anthropic/claude-opus-5-5
DEV_MODEL=anthropic/claude-opus-5-5
# qa: достатньо швидшої моделі
QA_MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Fine-grained PAT лише на Roman-Sharabura/dopamine-shop, окремий на кожного агента.
# lead: Issues RW, Pull requests RW (review, draft → ready), Contents R, Commit statuses R, Metadata R
GH_TOKEN_LEAD=
# ba: лише читає спеку — Contents R, Metadata R
GH_TOKEN_BA=
# architect: створює гілку з plan.md і tasks.md — Contents RW, Metadata R
GH_TOKEN_ARCHITECT=
# dev: Contents RW, Pull requests RW, Issues RW, Metadata R
GH_TOKEN_DEV=
# qa: Contents RW, Pull requests RW (коментар з вердиктом), Issues R, Metadata R
GH_TOKEN_QA=

# Пароль спільного Postgres для тестів у пісочниці (контейнер agent-team-postgres, назовні не відкритий)
AGENT_PG_PASSWORD=postgres

# Slack (Socket Mode), див. README «Slack»
# App-Level Token (xapp-...) зі scope connections:write
SLACK_APP_TOKEN=
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# Твій Slack member ID (U...): профіль → ⋮ → Copy member ID
SLACK_OWNER_ID=

# Telegram (необов'язково, вимкнено в openclaw.json5): бот від @BotFather і твій числовий id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
