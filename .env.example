# Copy to .env (it is in .gitignore) and fill in. Load with: set -a; source .env; set +a
# Absolute path to the repo (in WSL: /home/<user>/src/agent-team)
AGENT_TEAM_DIR=/home/roman/src/agent-team
# Gateway token for the Control UI and CLI; if empty, scripts/setup.sh generates it and appends it here
OPENCLAW_GATEWAY_TOKEN=

# Models: provider/model format, see `openclaw models list --provider anthropic` and README "Models".
# *_FALLBACK_MODEL: fallback model on rate limit (429) or failure; a different model class than the primary.
# Anthropic (price $/1M input / output / cache read from the OpenClaw 2026.9.9 catalog):
#   claude-haiku-5-5 0.1/0.5/0.01 (prompts up to 100k; above that 0.5/2.5/0.05) · claude-sonnet-5-5 2/10/0.2 · claude-opus-5-5 4/20/0.2
# lead: orchestration, comments, and checklist-based review (context capped at 64k in openclaw.json5)
LEAD_MODEL=anthropic/claude-haiku-5-5
LEAD_FALLBACK_MODEL=anthropic/claude-sonnet-5-5
# ba: spec validation
BA_MODEL=anthropic/claude-haiku-5-5
BA_FALLBACK_MODEL=anthropic/claude-sonnet-5-5
# architect: plan and ADRs
ARCHITECT_MODEL=anthropic/claude-sonnet-5-5
ARCHITECT_FALLBACK_MODEL=anthropic/claude-haiku-5-5
# dev: code; claude-opus-5-5 costs 2x Sonnet, enable only if Sonnet can't cope
DEV_MODEL=anthropic/claude-sonnet-5-5
DEV_FALLBACK_MODEL=anthropic/claude-haiku-5-5
# qa: tests from the spec
QA_MODEL=anthropic/claude-sonnet-5-5
QA_FALLBACK_MODEL=anthropic/claude-haiku-5-5
# API key from console.anthropic.com (Settings → API keys); setup.sh puts it into every agent's auth profile
ANTHROPIC_API_KEY=
# OpenAI instead (same price profile): lead/ba openai/gpt-6-luna (fallback openai/gpt-5.6-luna),
# architect/dev/qa openai/gpt-6.1-sol (fallback openai/gpt-6-sol). Leave empty while running on Anthropic.
OPENAI_API_KEY=

# Fine-grained PAT for Roman-Sharabura/dopamine-shop only, a separate one per agent.
# lead: Issues RW, Pull requests RW (review, draft → ready), Contents R, Commit statuses R, Metadata R
GH_TOKEN_LEAD=
# ba: only reads the spec: Contents R, Metadata R
GH_TOKEN_BA=
# architect: creates a branch with plan.md and tasks.md: Contents RW, Metadata R
GH_TOKEN_ARCHITECT=
# dev: Contents RW, Pull requests RW, Issues RW, Metadata R
GH_TOKEN_DEV=
# qa: Contents RW, Pull requests RW (verdict comment), Issues R, Metadata R
GH_TOKEN_QA=

# Password for the shared Postgres used by tests in the sandbox (container agent-team-postgres, not exposed outside)
AGENT_PG_PASSWORD=postgres

# Slack (Socket Mode), see README "Slack"
# App-Level Token (xapp-...) with scope connections:write
SLACK_APP_TOKEN=
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# Your Slack member ID (U...): profile → ⋮ → Copy member ID
SLACK_OWNER_ID=

# Morning briefing (scripts/automations.sh): cron and time zone, default Mon–Fri 09:00 Kyiv time
BRIEFING_CRON="0 9 * * 1-5"
BRIEFING_TZ=Europe/Kyiv

# Telegram (optional, disabled in openclaw.json5): bot from @BotFather and your numeric id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
