// Конфіг команди Spec → PR. Етап 3: lead → ba → architect → dev → qa; code review робить lead.
// Етап 5 (частково): dev і qa працюють і з адмінкою web/admin (Node 24 у пісочниці, скіли admin-ui-*).
// Запуск: export OPENCLAW_CONFIG_PATH="$AGENT_TEAM_DIR/openclaw.json5" (див. README).
// Звірено з документацією OpenClaw 2026.9.8.
{
  // Без gateway.mode шлюз відмовляється стартувати (openclaw gateway).
  gateway: { mode: "local", bind: "loopback" },
  // Ключі API зберігаються не тут, а в auth-профілях кожного агента (scripts/setup.sh).
  // OpenAI за API-ключем іде через вбудований рантайм OpenClaw, а не через Codex.
  models: {
    providers: {
      openai: { agentRuntime: { id: "openclaw" } },
    },
  },
  agents: {
    ownership: "explicit",
    defaults: {
      sandbox: {
        mode: "all",
        scope: "agent",
        workspaceAccess: "rw",
        docker: {
          image: "agent-team/dotnet-sandbox:10",
          // Власна мережа (створює scripts/setup.sh): вихід в інтернет для NuGet і GitHub
          // плюс спільний Postgres для інтеграційних тестів. Docker-сокет у пісочницю не монтуємо.
          network: "agent-team",
        },
        // Усі агенти ходять у GitHub одним ботом dopamine-dev-bot, тож хто що зробив, видно лише з підпису:
        // AGENT_ID → префікс **[<agent>]** у коментарях і трейлер Agent: у комітах (скіли github-issue, git-commit),
        // а в автора комітів ім'я агента в дужках. Пошта та сама, щоб коміти прив'язувались до бота.
      },
      heartbeat: { every: "0m" },
    },
    entries: {
      lead: {
        name: "Lead",
        workspace: "${AGENT_TEAM_DIR}/workspaces/lead",
        model: "${LEAD_MODEL}",
        skills: ["github-issue", "handoff", "pr-review"],
        subagents: { allowAgents: ["ba", "architect", "dev", "qa"], delegationMode: "prefer" },
        heartbeat: { every: "30m", isolatedSession: true, activeHours: { start: "08:00", end: "23:00" } },
        // Review пише коментарі через gh api, тож write/edit йому не потрібні.
        sandbox: { docker: { env: { GH_TOKEN: "${GH_TOKEN_LEAD}", AGENT_ID: "lead" } } },
        // Передачі між агентами: spawn і yield потрібні lead явно, незалежно від профілю інструментів.
        tools: { alsoAllow: ["sessions_spawn", "sessions_yield", "subagents"], deny: ["write", "edit", "apply_patch", "browser"] },
      },
      // Перевіряє спеку до будь-якої роботи: PASS або QUESTIONS. Лише читає, тож write/edit не має.
      ba: {
        name: "BA",
        workspace: "${AGENT_TEAM_DIR}/workspaces/ba",
        model: "${BA_MODEL}",
        skills: ["github-issue", "handoff", "spec-validate"],
        subagents: { allowAgents: [] },
        sandbox: { docker: { env: { GH_TOKEN: "${GH_TOKEN_BA}", AGENT_ID: "ba" } } },
        tools: { deny: ["write", "edit", "apply_patch", "browser"] },
      },
      // Створює гілку ai/<issue>-<slug> з plan.md і tasks.md (і чернеткою ADR, якщо треба); код не пише.
      architect: {
        name: "Architect",
        workspace: "${AGENT_TEAM_DIR}/workspaces/architect",
        model: "${ARCHITECT_MODEL}",
        skills: ["github-issue", "handoff", "repo-conventions", "spec-to-plan", "adr-writer", "git-commit", "admin-ui-feature"],
        subagents: { allowAgents: [] },
        sandbox: {
          docker: {
            env: {
              GH_TOKEN: "${GH_TOKEN_ARCHITECT}",
              AGENT_ID: "architect",
              GIT_AUTHOR_NAME: "dopamine-dev-bot (architect)",
              GIT_AUTHOR_EMAIL: "roma.sharabura+bot@gmail.com",
              GIT_COMMITTER_NAME: "dopamine-dev-bot",
              GIT_COMMITTER_EMAIL: "roma.sharabura+bot@gmail.com",
            },
          },
        },
        tools: { deny: ["browser"] },
      },
      dev: {
        name: "Dev",
        workspace: "${AGENT_TEAM_DIR}/workspaces/dev",
        model: "${DEV_MODEL}",
        skills: [
          "github-issue", "handoff", "repo-conventions", "minimal-api-feature", "dotnet-quality-gate", "git-commit",
          // адмінка web/admin (React + Vite)
          "admin-ui-feature", "admin-ui-gate",
          // github.com/dotnet/skills (vendor/dotnet-skills)
          "dotnet-webapi", "optimizing-ef-core-queries", "csharp-refactoring", "run-tests", "platform-detection", "filter-syntax",
        ],
        subagents: { allowAgents: [] },
        sandbox: {
          docker: {
            env: {
              GH_TOKEN: "${GH_TOKEN_DEV}",
              AGENT_ID: "dev",
              // Інтеграційні тести dopamine-shop беруть цей сервер замість Testcontainers.
              TEST_POSTGRES_CONNECTION: "Host=agent-team-postgres;Username=postgres;Password=${AGENT_PG_PASSWORD};Database=postgres",
              // Автор комітів задано тут, а не лише в TOOLS.md: без нього git commit падає, якщо агент забув git config.
              GIT_AUTHOR_NAME: "dopamine-dev-bot (dev)",
              GIT_AUTHOR_EMAIL: "roma.sharabura+bot@gmail.com",
              GIT_COMMITTER_NAME: "dopamine-dev-bot",
              GIT_COMMITTER_EMAIL: "roma.sharabura+bot@gmail.com",
            },
          },
        },
        tools: { deny: ["browser"] },
      },
      // Незалежна перевірка гілки dev: тести за сценаріями спеки й контрактом, qa-report.md.
      qa: {
        name: "QA",
        workspace: "${AGENT_TEAM_DIR}/workspaces/qa",
        model: "${QA_MODEL}",
        skills: [
          "github-issue", "handoff", "repo-conventions", "spec-to-tests", "dotnet-quality-gate", "git-commit",
          // адмінка web/admin (React + Vite)
          "admin-ui-feature", "admin-ui-gate",
          // github.com/dotnet/skills (vendor/dotnet-skills)
          "run-tests", "platform-detection", "filter-syntax", "test-anti-patterns", "assertion-quality", "test-analysis-extensions", "test-gap-analysis",
        ],
        subagents: { allowAgents: [] },
        sandbox: {
          docker: {
            env: {
              GH_TOKEN: "${GH_TOKEN_QA}",
              AGENT_ID: "qa",
              TEST_POSTGRES_CONNECTION: "Host=agent-team-postgres;Username=postgres;Password=${AGENT_PG_PASSWORD};Database=postgres",
              // Автор комітів задано тут, а не лише в TOOLS.md: без нього git commit падає, якщо агент забув git config.
              GIT_AUTHOR_NAME: "dopamine-dev-bot (qa)",
              GIT_AUTHOR_EMAIL: "roma.sharabura+bot@gmail.com",
              GIT_COMMITTER_NAME: "dopamine-dev-bot",
              GIT_COMMITTER_EMAIL: "roma.sharabura+bot@gmail.com",
            },
          },
        },
        tools: { deny: ["browser"] },
      },
    },
  },
  // Скіли лежать у workspaces/<agent>/skills (копії з skills/, scripts/sync-skills.sh):
  // тільки скіли воркспейсу доступні агенту в пісочниці як /workspace/skills.
  tools: {
    agentToAgent: { allow: ["lead", "ba", "architect", "dev", "qa"] },
    // Tool Search (типово увімкнений) ховає схеми інструментів за tool_search, а пошук працює
    // лише англійською. На SPEC-003 lead після PASS від ba не знайшов sessions_spawn і зупинився.
    // Інструментів у нас мало, тож даємо моделі прямі схеми.
    toolSearch: false,
  },
  // Канал Slack — окремий плагін (його пакет ставить scripts/setup.sh).
  plugins: {
    entries: { slack: { enabled: true } },
  },
  commands: {
    ownerAllowFrom: ["slack:${SLACK_OWNER_ID}"],
  },
  bindings: [
    { agentId: "lead", match: { channel: "slack", accountId: "*" } },
    { agentId: "lead", match: { channel: "telegram", accountId: "*" } },
  ],
  channels: {
    // Slack через Socket Mode: шлюз сам тримає з'єднання, публічна адреса не потрібна.
    slack: {
      enabled: true,
      mode: "socket",
      appToken: { source: "env", provider: "default", id: "SLACK_APP_TOKEN" },
      botToken: { source: "env", provider: "default", id: "SLACK_BOT_TOKEN" },
      dmPolicy: "allowlist",
      allowFrom: ["${SLACK_OWNER_ID}"],
    },
    // Telegram вимкнено. Щоб повернути, розкоментуй блок, заповни TELEGRAM_* у .env
    // і додай "telegram:${TELEGRAM_OWNER_ID}" у commands.ownerAllowFrom.
    // telegram: {
    //   accounts: {
    //     default: {
    //       botToken: "${TELEGRAM_BOT_TOKEN}",
    //       dmPolicy: "allowlist",
    //       allowFrom: ["tg:${TELEGRAM_OWNER_ID}"],
    //     },
    //   },
    // },
  },
}
