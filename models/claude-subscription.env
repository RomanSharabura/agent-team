# Model preset: Claude subscription (Pro/Max/Team plan) instead of the API key. Apply: ./scripts/use-models.sh claude-subscription [agent...]
# Needs ANTHROPIC_SETUP_TOKEN in .env, made once with `claude setup-token` (valid for a year). Calls draw from the
# plan's 5-hour and weekly limits, shared with your own Claude and Claude Code use; no per-token bill, so the budget
# guard skips dollar limits for these agents and applies the token limits in budget.json instead.
# Same models as the anthropic preset, so switching changes only who pays. Opus uses the plan's limits fastest:
# move DEV_MODEL, QA_MODEL or ARCHITECT_MODEL to Sonnet if the weekly limit runs out.
AUTH=subscription

LEAD_MODEL=anthropic/claude-sonnet-5-5
DEV_MODEL=anthropic/claude-opus-5-5
QA_MODEL=anthropic/claude-opus-5-5
BA_MODEL=anthropic/claude-sonnet-5-5
ARCHITECT_MODEL=anthropic/claude-opus-5-5

LEAD_FALLBACK_MODEL=anthropic/claude-haiku-5-5
DEV_FALLBACK_MODEL=anthropic/claude-sonnet-5-5
QA_FALLBACK_MODEL=anthropic/claude-sonnet-5-5
BA_FALLBACK_MODEL=anthropic/claude-haiku-5-5
ARCHITECT_FALLBACK_MODEL=anthropic/claude-sonnet-5-5
